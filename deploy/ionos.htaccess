# Static Mary Lou site on IONOS managed Apache webspace.
# Domain document root: /marylou (SFTP path: /public/marylou).
Options -Indexes
DirectoryIndex index.html

# The domain is now connected to this directory and the certificate is active.
# Redirect both HTTP and www to the canonical, HTTPS-only host.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} !^pasticceriamarylou\.it$ [NC]
    RewriteRule ^ https://pasticceriamarylou.it%{REQUEST_URI} [R=301,L,NE]
</IfModule>

<FilesMatch "(?i)(^\.|\.(?:env|ini|log|bak|sql|map|md|ya?ml|pem|key)$|^(?:package(?:-lock)?\.json|CNAME)$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # One-day HSTS without includeSubDomains: increase only after monitoring.
    Header always set Strict-Transport-Security "max-age=86400"
    # GSAP uses inline styles. The only remote resources are fonts and the map.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-src https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    <FilesMatch "\.(?:html|json)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

